# Copiá este archivo a .env para configurar la API.
# En Expo Go usá la IP de tu compu en la misma wifi: localhost apunta al teléfono.
# En la compu podés usar localhost. El APK necesita una API publicada con https.
EXPO_PUBLIC_API_URL=http://192.168.1.7:3100

# Clave de Google Maps para Android (Maps SDK for Android). En EAS va como secret.
GOOGLE_MAPS_KEY=
